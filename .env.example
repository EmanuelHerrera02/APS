# Copiar a .env y completar solo en el entorno local. Nunca cargar credenciales reales al repo.
AERONET_JDBC_URL=jdbc:mariadb://localhost:3306/aeronet
AERONET_DB_USER=aeronet_app
AERONET_DB_PASSWORD=

# Usá smtp o sendgrid. SMTP es el modo local predeterminado.
AERONET_EMAIL_PROVIDER=smtp
AERONET_EMAIL_WORKER_ENABLED=true
AERONET_SMTP_HOST=
AERONET_SMTP_PORT=587
AERONET_SMTP_FROM=
AERONET_SMTP_USER=
AERONET_SMTP_PASSWORD=
AERONET_SMTP_STARTTLS=true
AERONET_SMTP_SSL=false
# Opcionales: nombre EHLO (por defecto, el dominio del remitente) y dominio autenticado con SPF/DKIM.
AERONET_SMTP_EHLO_NAME=
AERONET_EMAIL_DOMAIN=

# Para SendGrid: API key restringida a Mail Send y clave pública EC del Signed Event Webhook.
AERONET_SENDGRID_API_KEY=
AERONET_SENDGRID_WEBHOOK_PUBLIC_KEY=

# Token para webhook normalizado/proxy (mínimo 32 caracteres). SendGrid directo usa firma ECDSA.
AERONET_EMAIL_WEBHOOK_SECRET=

# Opcional; por defecto los PDFs se guardan en var/documentos.
AERONET_DOCUMENT_STORAGE=var/documentos

# Pago en línea (US9) con Mercado Pago. Sin AERONET_PAYMENT_PROVIDER el pago en línea queda deshabilitado.
# Credenciales de prueba (TEST-...) de la aplicación en Mercado Pago Developers; ver docs/us9/pasarela-de-pago.md.
AERONET_PAYMENT_PROVIDER=mercadopago
AERONET_MP_PUBLIC_KEY=
AERONET_MP_ACCESS_TOKEN=
# Clave secreta de la sección Webhooks de la aplicación (mínimo 16 caracteres).
AERONET_MP_WEBHOOK_SECRET=
AERONET_MP_ENVIRONMENT=sandbox
# Solo para el sandbox local (tests/sandbox/mercadopago-sandbox.mjs); vacío usa Mercado Pago.
AERONET_MP_API_URL=
AERONET_MP_SDK_URL=
AERONET_PAYMENT_RECONCILE_SECONDS=30

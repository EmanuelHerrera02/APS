# Copiar a .env y completar solo en el entorno local. Nunca cargar credenciales reales al repo.
AERONET_JDBC_URL=jdbc:mariadb://localhost:3306/aeronet
AERONET_DB_USER=aeronet_app
AERONET_DB_PASSWORD=

# El worker de email permanece inactivo si faltan HOST o FROM.
AERONET_EMAIL_WORKER_ENABLED=true
AERONET_SMTP_HOST=
AERONET_SMTP_PORT=587
AERONET_SMTP_FROM=
AERONET_SMTP_USER=
AERONET_SMTP_PASSWORD=
AERONET_SMTP_STARTTLS=true
AERONET_SMTP_SSL=false

# Opcional; por defecto los PDFs se guardan en var/documentos.
AERONET_DOCUMENT_STORAGE=var/documentos

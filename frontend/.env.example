# Frontend Environment Variables
#
# Copiá esto a .env y cambiá lo que necesites:  cp .env.example .env
#
# OJO con el prefijo. Acá va VITE_ y no REACT_APP_ porque el build es Vite
# (vite y @vitejs/plugin-react en devDependencies, scripts dev/build con vite):
# Vite solo expone a import.meta.env las variables que arrancan con VITE_, y las
# de REACT_APP_ de Create React App se ignoran en silencio. Este archivo usaba
# REACT_APP_ y por eso la URL de la API llegaba como undefined sin avisar.
#
# AltaVuelo.jsx lee VITE_API_URL.

# API Configuration
VITE_API_URL=http://localhost:8080

# App Configuration
VITE_ENV=development
VITE_APP_NAME=Transport System
